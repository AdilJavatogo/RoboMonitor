{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Robot API keys for authentication, dette er kun test. I produktion bør disse nøgler opbevares sikkert, f.eks. i en hemmelig vault eller miljøvariabler.
  "RobotApiKeys": {
    "Robot_Herlev_1": "herlev_ghi789",
    "Robot_Herlev_2": "herlev_xyz123",
    "Robot_OUH_1": "ouh_abc456"
  },

  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://api:8080"
          }
        }
      }
    },

    "Kestrel": {
      "Endpoints": {
        "Http": {
          "Url": "http://0.0.0.0:80"
        },
        "Https": {
          "Url": "https://0.0.0.0:443",
          "Certificate": {
            "Path": "/etc/letsencrypt/live/robomonitor.duckdns.org/fullchain.pem",
            "KeyPath": "/etc/letsencrypt/live/robomonitor.duckdns.org/privkey.pem"
          }
        }
      }
    }
  }
}