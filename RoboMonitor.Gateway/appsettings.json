{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "RobotApiKeys": {
    "Robot_Herlev_1": "herlev_ghi789",
    "Robot_Herlev_2": "herlev_xyz123",
    "Robot_OUH_1": "ouh_abc456"
  },

  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "grafana-route": {
        "ClusterId": "grafana-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "HttpRequest": {
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://api:8080"
          }
        }
      },
      "grafana-cluster": {
        "HttpRequest": {
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://grafana:3000"
          }
        }
      }
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:80"
      },
      "Https": {
        "Url": "https://0.0.0.0:443",
        "Certificate": {
          "Path": "/etc/letsencrypt/live/robomonitor.duckdns.org/fullchain.pem",
          "KeyPath": "/etc/letsencrypt/live/robomonitor.duckdns.org/privkey.pem"
        }
      }
    }
  }
}